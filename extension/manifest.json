{
  "manifest_version": 3,
  "name": "Wiki ↔ Markdown",
  "version": "1.0.0",
  "description": "Bidirectional converter: copy wiki pages as Markdown (with base64 images), or paste Markdown as wiki markup into issue trackers and knowledge bases.",
  "browser_specific_settings": {
    "gecko": {
      "id": "jira-markdown@zoonderkins",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "clipboardWrite",
    "clipboardRead",
    "activeTab",
    "storage",
    "menus",
    "downloads"
  ],
  "commands": {
    "copy-as-markdown": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "MacCtrl+Shift+M"
      },
      "description": "Copy current page as Markdown"
    },
    "insert-markdown": {
      "suggested_key": {
        "default": "Ctrl+Shift+J",
        "mac": "MacCtrl+Shift+J"
      },
      "description": "Insert clipboard Markdown into Jira"
    }
  },
  "host_permissions": [
    "*://*.atlassian.net/*",
    "*://*.atlassian.com/*",
    "*://*.atl-paas.net/*",
    "*://*.jira.com/*",
    "*://media-cdn.atlassian.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.atlassian.net/*",
        "*://*.jira.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
